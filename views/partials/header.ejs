<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : "Beaver's Bridge | Organic Community Lead Generation" %></title>
  <meta name="description" content="<%= (typeof description !== 'undefined' && description) ? description : "Unlock high-intent organic leads and establish an undeniable community presence without spending a dime on ads." %>">
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/favicon-128.png">

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Google Fonts Suite: Avenir-style Montserrat (Titles & Subheadings) + Inter (Body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Montserrat:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500;1,700&display=swap" rel="stylesheet">

  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- Navigation Bar: Forest Green Background (#015112) with White & Acorn Gold Text -->
  <header class="navbar">
    <div class="container nav-container">
      <a href="/" class="brand-logo" aria-label="Beaver's Bridge Home">
        <img src="/images/logo.png" alt="Beaver's Bridge Emblem" class="brand-emblem">
        <div class="brand-text">
          <span class="brand-name">Beaver's Bridge</span>
          <span class="brand-tag">Community Growth</span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav>
        <ul class="nav-links">
          <li><a href="/" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/') ? 'active' : '' %>">Home</a></li>
          <li><a href="/services" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/services') ? 'active' : '' %>">Services</a></li>
          <li><a href="/projects" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/projects') ? 'active' : '' %>">Projects</a></li>
          <li><a href="/about" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/about') ? 'active' : '' %>">About Us</a></li>
          <li><a href="/contact" class="nav-link <%= (typeof currentPath !== 'undefined' && currentPath === '/contact') ? 'active' : '' %>">Contact</a></li>
        </ul>
      </nav>

      <!-- Action Button: Soft Rounded Corners with Moss Green -> Forest Green on Hover -->
      <div class="nav-actions">
        <a href="/contact" class="btn btn-moss">
          <span>Book a Call</span>
          <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
        </a>
        <button class="mobile-toggle" aria-label="Toggle navigation menu">
          <i data-lucide="menu"></i>
        </button>
      </div>
    </div>
  </header>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer">
    <div class="mobile-drawer-header">
      <div class="brand-logo">
        <img src="/images/logo.png" alt="Beaver's Bridge" class="brand-emblem">
        <span class="brand-name">Beaver's Bridge</span>
      </div>
      <button class="mobile-drawer-close" aria-label="Close menu">
        <i data-lucide="x"></i>
      </button>
    </div>

    <ul class="mobile-nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/services">Services</a></li>
      <li><a href="/projects">Projects &amp; Work</a></li>
      <li><a href="/about">About Us</a></li>
      <li><a href="/contact">Contact</a></li>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <li><a href="/admin" style="color: var(--acorn-gold);">Admin Dashboard</a></li>
      <% } else { %>
        <li><a href="/login" style="font-size: 0.95rem; color: var(--creamy-ivory);">Admin Portal</a></li>
      <% } %>
    </ul>

    <div style="margin-top: auto;">
      <a href="/contact" class="btn btn-moss" style="width: 100%;">
        <span>Book Strategy Session</span>
        <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
      </a>
    </div>
  </div>
