<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : "Beaver's Bridge | Organic Local Lead Generation" %></title>
  <meta name="description" content="<%= (typeof description !== 'undefined' && description) ? description : "Organic Facebook lead generation and community marketing agency for local service contractors. Verified inbound leads with exclusive territory protection." %>">
  
  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/images/favicon.png">
  <link rel="apple-touch-icon" href="/images/favicon-128.png">

  <!-- Google Fonts: Plus Jakarta Sans & Outfit -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700&display=swap" rel="stylesheet">

  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>

  <!-- Main Stylesheet -->
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <!-- 3D Ambient Glowing Mesh Background -->
  <div class="ambient-bg-canvas" aria-hidden="true">
    <div class="ambient-sphere sphere-1"></div>
    <div class="ambient-sphere sphere-2"></div>
    <div class="ambient-sphere sphere-3"></div>
  </div>
  <div class="ambient-grid" aria-hidden="true"></div>

  <!-- Glassmorphic Navigation -->
  <nav class="navbar">
    <div class="nav-inner">
      <a href="/" class="nav-logo-container" aria-label="Beaver's Bridge Home">
        <img src="/images/logo-emblem.png" alt="Beaver's Bridge Emblem" class="nav-logo-img">
        <span class="nav-logo-text">Beaver's Bridge<span>.</span></span>
      </a>

      <!-- Desktop Nav: Focused & High-Impact -->
      <ul class="nav-links">
        <li><a href="#features">What You Get</a></li>
        <li><a href="#portfolio">Featured Results &amp; Charts</a></li>
        <li><a href="#comparison">Why Us</a></li>
        <li><a href="#benefits">How It Works</a></li>
        <li>
          <a href="tel:<%= (typeof settings !== 'undefined' && settings && settings.contact_phone) ? settings.contact_phone.replace(/[^0-9+]/g, '') : '+13477664135' %>" class="nav-phone-btn" title="Call or text us">
            <i data-lucide="phone" style="width: 14px; height: 14px; color: var(--emerald-glow);"></i>
            <span><%= (typeof settings !== 'undefined' && settings && settings.contact_phone) ? settings.contact_phone : '+1 (347) 766-4135' %></span>
          </a>
        </li>
        <li><a href="#contact" class="nav-cta">Check Territory</a></li>
      </ul>

      <!-- Mobile Hamburger Button -->
      <button class="mobile-toggle" aria-label="Toggle navigation menu">
        <i data-lucide="menu"></i>
      </button>
    </div>
  </nav>

  <!-- Mobile Drawer Menu -->
  <div class="mobile-drawer">
    <div class="mobile-drawer-header">
      <div class="nav-logo-container">
        <img src="/images/logo-emblem.png" alt="Beaver's Bridge Emblem" class="nav-logo-img">
        <span class="nav-logo-text">Beaver's Bridge<span>.</span></span>
      </div>
      <button class="mobile-drawer-close" aria-label="Close menu">
        <i data-lucide="x"></i>
      </button>
    </div>

    <ul class="mobile-nav-links">
      <li><a href="#features" class="mobile-nav-link">What You Get</a></li>
      <li><a href="#portfolio" class="mobile-nav-link">Featured Results &amp; Charts</a></li>
      <li><a href="#comparison" class="mobile-nav-link">Why Us</a></li>
      <li><a href="#benefits" class="mobile-nav-link">How It Works</a></li>
      <li><a href="#contact" class="mobile-nav-link" style="color: var(--emerald-glow); font-weight: 800;">Check Territory Availability</a></li>
    </ul>

    <div style="margin-top: auto; padding-top: 1.5rem; display: flex; flex-direction: column; gap: 10px;">
      <a href="tel:<%= (typeof settings !== 'undefined' && settings && settings.contact_phone) ? settings.contact_phone.replace(/[^0-9+]/g, '') : '+13477664135' %>" class="btn-secondary" style="width: 100%; justify-content: center; font-size: 0.95rem;">
        <i data-lucide="phone" style="width: 16px; height: 16px; color: var(--forest-green);"></i>
        <span>Call: <%= (typeof settings !== 'undefined' && settings && settings.contact_phone) ? settings.contact_phone : '+1 (347) 766-4135' %></span>
      </a>

      <a href="#contact" class="btn-primary mobile-drawer-cta" style="width: 100%; justify-content: center;">
        <span>Check Territory Availability</span>
        <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
      </a>
    </div>
  </div>
