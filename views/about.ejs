<%- include('partials/header') %>

<!-- ABOUT HERO -->
<section class="hero">
  <div class="container hero-content" style="text-align: center; max-width: 800px; margin: 0 auto;">
    <div class="badge-pill badge-gold">
      <i data-lucide="compass" style="width: 14px; height: 14px;"></i>
      <span>Our Genesis &amp; Philosophy</span>
    </div>
    <h1 class="hero-title" style="font-size: 2.7rem; margin-bottom: 12px;">
      Crafting Enduring Bridges <br>
      <span class="text-gold">Between Brands &amp; Communities</span>
    </h1>
    <p class="hero-subtitle" style="margin-bottom: 0;">
      Beaver’s Bridge was founded on a fundamental truth: the most resilient, high-profit businesses aren’t flashy advertisers; they are revered community cornerstones.
    </p>
  </div>
</section>

<!-- STORY & CRAFTSMANSHIP SECTION -->
<section class="section section-white" style="padding-top: 20px;">
  <div class="container">
    <div style="display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 36px; align-items: center;">
      <div>
        <div class="badge-pill">
          <i data-lucide="book-open" style="width: 14px; height: 14px;"></i>
          <span>The Story Behind The Name</span>
        </div>
        <h2 style="font-size: 2.4rem; color: var(--forest-green); margin-bottom: 20px; line-height: 1.2;">
          Why the Beaver? <br>
          <span class="text-gold">Nature’s Master Engineer</span>
        </h2>
        <p style="font-size: 1.05rem; line-height: 1.7; margin-bottom: 18px; color: var(--text-body);">
          The beaver does not shout to demand attention. With relentless patience, skill, and architectural precision, it fells timber and constructs resilient dams and bridges that transform entire ecosystems.
        </p>
        <p style="font-size: 1.05rem; line-height: 1.7; margin-bottom: 24px; color: var(--text-body);">
          At Beaver’s Bridge, we bring that same master-builder discipline to digital growth. Together with our squirrel collaborators—representing agile community intelligence and sharp resource gathering—we build sustainable word-of-mouth infrastructure that outlives any algorithm change.
        </p>

        <div style="display: flex; gap: 20px; flex-wrap: wrap;">
          <div style="background: var(--bg-creamy); border: 1.5px solid var(--border-creamy); padding: 18px 24px; border-radius: var(--radius-md); flex: 1; min-width: 180px;">
            <div style="font-size: 2rem; font-weight: 800; color: var(--forest-green);">100%</div>
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted);">Organic Community Focus</div>
          </div>
          <div style="background: var(--bg-creamy); border: 1.5px solid var(--border-creamy); padding: 18px 24px; border-radius: var(--radius-md); flex: 1; min-width: 180px;">
            <div style="font-size: 2rem; font-weight: 800; color: var(--acorn-gold);">$0</div>
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-muted);">Wasted On Low-Intent Ads</div>
          </div>
        </div>
      </div>

      <div style="display: flex; justify-content: center;">
        <div style="position: relative; width: 100%; max-width: 460px; border-radius: var(--radius-lg); overflow: hidden; border: 3px solid var(--forest-green); box-shadow: var(--shadow-logo);">
          <img src="/images/brand-board.jpg" alt="Beaver's Bridge Craftsmanship" style="width: 100%; height: auto; display: block;">
        </div>
      </div>
    </div>
  </div>
</section>

<!-- CORE PILLARS & VALUES -->
<section class="section section-cream">
  <div class="container">
    <div class="section-header">
      <div class="badge-pill badge-gold">
        <i data-lucide="award" style="width: 14px; height: 14px;"></i>
        <span>Our Guiding Principles</span>
      </div>
      <h2 class="section-title">
        The Four Pillars of Beaver's Bridge Craft
      </h2>
    </div>

    <div class="process-grid">
      <div class="process-card">
        <div style="color: var(--forest-green); margin-bottom: 16px;">
          <i data-lucide="shield-check" style="width: 32px; height: 32px;"></i>
        </div>
        <h3>Reputation Over Spruik</h3>
        <p>We refuse to resort to spammy clickbait or pushy sales pitches. We treat your brand’s reputation with reverence, ensuring every public touchpoint exudes authority.</p>
      </div>

      <div class="process-card">
        <div style="color: var(--acorn-gold); margin-bottom: 16px;">
          <i data-lucide="feather" style="width: 32px; height: 32px;"></i>
        </div>
        <h3>Masterful Copywriting</h3>
        <p>Words create reality. Our elite narrative copywriters highlight your craftsmanship, material choices, and problem-solving skill so customers recognize your true worth.</p>
      </div>

      <div class="process-card">
        <div style="color: var(--river-blue); margin-bottom: 16px;">
          <i data-lucide="heart-handshake" style="width: 32px; height: 32px;"></i>
        </div>
        <h3>Radical Transparency</h3>
        <p>We provide weekly, unvarnished reporting on impressions, response rates, and revenue. You always know where every single inquiry came from.</p>
      </div>

      <div class="process-card">
        <div style="color: var(--beaver-brown); margin-bottom: 16px;">
          <i data-lucide="trending-up" style="width: 32px; height: 32px;"></i>
        </div>
        <h3>Compounding Assets</h3>
        <p>Unlike ads that vanish when the budget runs out, positive community reputation lingers and snowballs into years of word-of-mouth referrals.</p>
      </div>
    </div>
  </div>
</section>

<!-- TESTIMONIAL HIGHLIGHT -->
<section class="section section-white">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">
        Trusted By Forward-Thinking Contractors &amp; Founders
      </h2>
    </div>

    <div class="testimonials-grid">
      <% testimonials.forEach(t => { %>
        <div class="testimonial-card">
          <div class="testimonial-metric-callout">
            <i data-lucide="zap" style="width: 14px; height: 14px;"></i>
            <span><%= t.highlight_metric %></span>
          </div>
          <p class="testimonial-quote">"<%= t.quote %>"</p>
          <div class="testimonial-author-row">
            <img src="<%= t.avatar_url %>" alt="<%= t.client_name %>" class="author-avatar">
            <div class="author-info">
              <h4><%= t.client_name %></h4>
              <p><%= t.client_role %>, <%= t.client_company %></p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>

    <div style="text-align: center; margin-top: 50px;">
      <a href="/contact" class="btn btn-moss" style="padding: 16px 36px;">
        <span>Speak with Our Growth Architects</span>
        <i data-lucide="arrow-right" style="width: 18px; height: 18px;"></i>
      </a>
    </div>
  </div>
</section>

<%- include('partials/case-study-modal') %>
<%- include('partials/footer') %>
