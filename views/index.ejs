<%- include('partials/header') %>

  <!-- Hero Section -->
  <header class="hero">
    <div class="hero-container">
      <div class="hero-content">
        <div class="hero-badge">
          <span class="pulse-indicator"></span>
          <span>Local Contractor Lead Generation • 1 Trade Per Zip</span>
        </div>

        <h1>
          Get Real Homeowner Leads From People Who 
          <span>Need Work Done</span>.
        </h1>

        <p>
          When someone in your town asks local Facebook groups who to hire for roofing, remodeling, or home services, we make sure you get recommended. No shared leads, no cold calls, and no competing with five other contractors in your area.
        </p>

        <div class="hero-btns">
          <a href="#contact" class="btn-primary">
            <span>Check If Your Town Is Open</span>
            <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
          </a>
          <a href="#portfolio" class="btn-secondary">View Actual Lead Charts</a>
        </div>
      </div>

      <!-- 3D Hero Card -->
      <div class="hero-visual">
        <div class="tilt-card hero-graphic-card">
          <div class="hero-logo-showcase">
            <img src="/images/logo-emblem.png" alt="Beaver's Bridge Emblem">
            <div class="live-badge-floating">
              <span class="pulse-indicator" style="width: 6px; height: 6px;"></span>
              <span>Protected Area</span>
            </div>
          </div>

          <h3>One Contractor Per Trade</h3>
          <p>If we take you on for roofing, remodeling, or fencing in your town, we will never take on another contractor in your zip code. All local jobs go straight to you.</p>

          <div class="metric-pill-box">
            <i data-lucide="shield-check" style="width: 17px; height: 17px; color: var(--emerald-glow);"></i>
            <span>1 Trade Per Zip • Calls Go Directly To You</span>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- Clean Trust Numbers Bar -->
  <section class="trust-bar-section">
    <div class="trust-bar-container">
      <div class="trust-item">
        <div class="trust-item-icon">
          <i data-lucide="calendar-check" style="width: 22px; height: 22px;"></i>
        </div>
        <div class="trust-item-data">
          <span class="trust-item-value">14 Days</span>
          <span class="trust-item-label">Average time to first quote</span>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-item-icon">
          <i data-lucide="user-check" style="width: 22px; height: 22px;"></i>
        </div>
        <div class="trust-item-data">
          <span class="trust-item-value">98%</span>
          <span class="trust-item-label">Homeowner show-up rate</span>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-item-icon">
          <i data-lucide="shield-check" style="width: 22px; height: 22px;"></i>
        </div>
        <div class="trust-item-data">
          <span class="trust-item-value">Zero</span>
          <span class="trust-item-label">Shared leads (only you get the call)</span>
        </div>
      </div>

      <div class="trust-item">
        <div class="trust-item-icon">
          <i data-lucide="trending-up" style="width: 22px; height: 22px;"></i>
        </div>
        <div class="trust-item-data">
          <span class="trust-item-value">$3.4M+</span>
          <span class="trust-item-label">Jobs booked by our partners</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Core Features -->
  <section class="results" id="features">
    <div class="section-header">
      <span class="section-tag"><i data-lucide="layers" style="width: 13px; height: 13px;"></i> What We Do For You</span>
      <h2>How We Keep Your Crews Busy Year-Round</h2>
      <p>Three simple things we do every week to keep qualified estimates hitting your calendar.</p>
    </div>

    <div class="grid-3">
      <div class="card tilt-card">
        <div class="card-icon">01</div>
        <h3>Real Homeowners In Your Towns</h3>
        <p>You get direct calls and messages from local owners asking for an estimate on their roof, kitchen, or fence. Not tire-kickers, but people looking to hire.</p>
      </div>

      <div class="card tilt-card">
        <div class="card-icon">02</div>
        <h3>Your Territory Is Locked</h3>
        <p>We never work with your direct competitors in the same town. When someone asks for a recommendation, our team only mentions your company.</p>
      </div>

      <div class="card tilt-card">
        <div class="card-icon">03</div>
        <h3>Simple Weekly Check-Ins</h3>
        <p>Every Friday you see exactly where recommendations went up, what jobs came in, and what quotes are pending. Clear numbers, no smoke and mirrors.</p>
      </div>
    </div>
  </section>

  <!-- Featured Work & Charts -->
  <section class="portfolio" id="portfolio">
    <div class="section-header">
      <span class="section-tag"><i data-lucide="bar-chart-2" style="width: 13px; height: 13px;"></i> Real Contractor Results</span>
      <h2>Actual Lead Charts From Real Jobs</h2>
      <p>Click the toggle on any card below to view actual monthly lead growth charts versus photos of completed jobs.</p>
    </div>

    <div class="portfolio-grid">
      <!-- Project 1: Bumble Roofing -->
      <div class="project-card tilt-card"
           data-title="Bumble Roofing (Philadelphia Area)"
           data-client="Bumble Roofing"
           data-category="Roofing &amp; Exteriors"
           data-summary="Captured steady residential storm damage and full roof replacement calls across suburban Philly."
           data-challenge="They were spending $85+ per click on Google ads, getting calls from outside their service area."
           data-solution="We put their crew in front of local suburban Facebook groups right after spring storm season."
           data-metrics="123 Leads | $300,000+ In Jobs | 0$ Ad Spend"
           data-chart="/images/projects/chart-roofing.svg"
           data-image="/images/projects/roofing.jpg">

        <div class="view-switcher-bar">
          <div class="view-tab-btns">
            <button type="button" class="tab-btn tab-chart active">
              <i data-lucide="line-chart" style="width: 12px; height: 12px;"></i>
              <span>Lead Chart</span>
            </button>
            <button type="button" class="tab-btn tab-photo">
              <i data-lucide="image" style="width: 12px; height: 12px;"></i>
              <span>Roof Photos</span>
            </button>
          </div>
          <span class="verified-stamp">
            <i data-lucide="check-circle" style="width: 12px; height: 12px;"></i>
            <span>Active Partner</span>
          </span>
        </div>

        <div class="project-media-viewport">
          <div class="media-layer media-chart-layer">
            <img src="/images/projects/chart-roofing.svg" alt="Bumble Roofing Lead Growth Chart" loading="lazy">
          </div>
          <div class="media-layer media-photo-layer">
            <img src="/images/projects/roofing.jpg" alt="Bumble Roofing Project Work" loading="lazy">
          </div>
        </div>

        <div class="project-body">
          <div class="project-client-row">
            <span class="project-client">Bumble Roofing (PA)</span>
            <span class="project-category-tag">Roofing</span>
          </div>

          <h3 class="project-title">Storm Damage &amp; Replacement Calls</h3>

          <div class="project-pill">
            <i data-lucide="trending-up" style="width: 15px; height: 15px; color: var(--emerald-glow);"></i>
            <span>123 Estimates Booked | $300k+ In Jobs</span>
          </div>

          <p class="project-desc">We positioned their crew as the go-to neighborhood roofer after spring storms, generating consistent quote calls without paying for Google ads.</p>

          <button type="button" class="btn-card-action btn-case-study">
            <span>View Job Breakdown</span>
            <i data-lucide="arrow-right" style="width: 14px; height: 14px;"></i>
          </button>
        </div>
      </div>

      <!-- Project 2: Second Chance Remodeling -->
      <div class="project-card tilt-card"
           data-title="Second Chance Remodeling"
           data-client="Second Chance Home Improvements"
           data-category="Kitchens &amp; Remodeling"
           data-summary="Scaled high-ticket kitchen, bathroom, and deck renovations across target residential towns."
           data-challenge="They relied strictly on sporadic word-of-mouth and had slow winters with no predictable pipeline."
           data-solution="We shared their real craftsmanship before-and-after stories in high-income neighborhood groups."
           data-metrics="163 Leads | $420,000 Pipeline | 4.8x ROI"
           data-chart="/images/projects/chart-remodel.svg"
           data-image="/images/projects/remodel.jpg">

        <div class="view-switcher-bar">
          <div class="view-tab-btns">
            <button type="button" class="tab-btn tab-chart active">
              <i data-lucide="bar-chart" style="width: 12px; height: 12px;"></i>
              <span>Revenue Chart</span>
            </button>
            <button type="button" class="tab-btn tab-photo">
              <i data-lucide="image" style="width: 12px; height: 12px;"></i>
              <span>Kitchen Photos</span>
            </button>
          </div>
          <span class="verified-stamp">
            <i data-lucide="check-circle" style="width: 12px; height: 12px;"></i>
            <span>Active Partner</span>
          </span>
        </div>

        <div class="project-media-viewport">
          <div class="media-layer media-chart-layer">
            <img src="/images/projects/chart-remodel.svg" alt="Second Chance Remodeling Revenue Chart" loading="lazy">
          </div>
          <div class="media-layer media-photo-layer">
            <img src="/images/projects/remodel.jpg" alt="Second Chance Remodeling Work" loading="lazy">
          </div>
        </div>

        <div class="project-body">
          <div class="project-client-row">
            <span class="project-client">Second Chance Remodeling</span>
            <span class="project-category-tag">Kitchens &amp; Baths</span>
          </div>

          <h3 class="project-title">Kitchen &amp; Bath Renovation Jobs</h3>

          <div class="project-pill">
            <i data-lucide="trending-up" style="width: 15px; height: 15px; color: var(--emerald-glow);"></i>
            <span>163 Leads | $420,000 In Contracts</span>
          </div>

          <p class="project-desc">Helped them showcase real before-and-after projects in high-end suburban groups, landing steady $25k to $45k renovation contracts.</p>

          <button type="button" class="btn-card-action btn-case-study">
            <span>View Job Breakdown</span>
            <i data-lucide="arrow-right" style="width: 14px; height: 14px;"></i>
          </button>
        </div>
      </div>

      <!-- Project 3: Hello Garage -->
      <div class="project-card tilt-card"
           data-title="Hello Garage (Upstate NY)"
           data-client="Hello Garage"
           data-category="Garage Floor Coatings"
           data-summary="Booked out polyaspartic garage floor coating consultations across three suburban counties."
           data-challenge="Homeowners were buying cheap DIY kits that peeled after one winter, hurting market perception."
           data-solution="Showed homeowners why industrial coatings last 15+ years through helpful community posts."
           data-metrics="82 Qualified Leads | 68% Close Rate | $240 CAC"
           data-chart="/images/projects/chart-garage.svg"
           data-image="/images/projects/garage.jpg">

        <div class="view-switcher-bar">
          <div class="view-tab-btns">
            <button type="button" class="tab-btn tab-chart active">
              <i data-lucide="line-chart" style="width: 12px; height: 12px;"></i>
              <span>Booking Curve</span>
            </button>
            <button type="button" class="tab-btn tab-photo">
              <i data-lucide="image" style="width: 12px; height: 12px;"></i>
              <span>Floor Photos</span>
            </button>
          </div>
          <span class="verified-stamp">
            <i data-lucide="check-circle" style="width: 12px; height: 12px;"></i>
            <span>Active Partner</span>
          </span>
        </div>

        <div class="project-media-viewport">
          <div class="media-layer media-chart-layer">
            <img src="/images/projects/chart-garage.svg" alt="Hello Garage Booking Curve" loading="lazy">
          </div>
          <div class="media-layer media-photo-layer">
            <img src="/images/projects/garage.jpg" alt="Hello Garage Coating Work" loading="lazy">
          </div>
        </div>

        <div class="project-body">
          <div class="project-client-row">
            <span class="project-client">Hello Garage (NY)</span>
            <span class="project-category-tag">Concrete Coatings</span>
          </div>

          <h3 class="project-title">Floor Coating Consultation Scale</h3>

          <div class="project-pill">
            <i data-lucide="trending-up" style="width: 15px; height: 15px; color: var(--emerald-glow);"></i>
            <span>82 Leads | 68% Close Rate</span>
          </div>

          <p class="project-desc">Tapped into neighborhood homeowner groups across 3 counties, filling their install calendar 6 weeks out.</p>

          <button type="button" class="btn-card-action btn-case-study">
            <span>View Job Breakdown</span>
            <i data-lucide="arrow-right" style="width: 14px; height: 14px;"></i>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Honest Comparison Section -->
  <section class="comparison-section" id="comparison">
    <div class="section-header">
      <span class="section-tag"><i data-lucide="check" style="width: 13px; height: 13px;"></i> Clear Comparison</span>
      <h2>Why This Works Better Than Buying Shared Leads</h2>
      <p>If you have ever bought leads from Angi, HomeAdvisor, or Thumbtack, you already know the story.</p>
    </div>

    <div class="comparison-card-grid">
      <div class="comparison-box comparison-bad">
        <div class="comp-header">
          <i data-lucide="x-circle" style="color: #ef4444; width: 24px; height: 24px;"></i>
          <h3 style="color: #991b1b;">Buying Shared Leads Online</h3>
        </div>
        <ul class="comp-list">
          <li>
            <i data-lucide="x" style="color: #ef4444; width: 16px; height: 16px; flex-shrink: 0; margin-top: 3px;"></i>
            <span><strong>Sold To 5 Guys:</strong> The second a lead comes in, it gets texted to you and four other contractors. It turns into a race to the bottom on price.</span>
          </li>
          <li>
            <i data-lucide="x" style="color: #ef4444; width: 16px; height: 16px; flex-shrink: 0; margin-top: 3px;"></i>
            <span><strong>Tire Kickers &amp; Ghosting:</strong> People fill out a form, never pick up your phone calls, or say they already hired someone 10 minutes ago.</span>
          </li>
          <li>
            <i data-lucide="x" style="color: #ef4444; width: 16px; height: 16px; flex-shrink: 0; margin-top: 3px;"></i>
            <span><strong>Wasted Spend:</strong> You pay $80 to $150 per click or per lead whether you win the job or not.</span>
          </li>
        </ul>
      </div>

      <div class="comparison-box comparison-good">
        <div class="comp-header">
          <i data-lucide="check-circle-2" style="color: #059669; width: 24px; height: 24px;"></i>
          <h3 style="color: var(--forest-green);">Beaver's Bridge Referral System</h3>
        </div>
        <ul class="comp-list">
          <li>
            <i data-lucide="check" style="color: #059669; width: 16px; height: 16px; flex-shrink: 0; margin-top: 3px;"></i>
            <span><strong>100% Exclusive To You:</strong> The homeowner contacts you specifically to quote their job. Nobody else gets the lead.</span>
          </li>
          <li>
            <i data-lucide="check" style="color: #059669; width: 16px; height: 16px; flex-shrink: 0; margin-top: 3px;"></i>
            <span><strong>Neighbors Trust Neighbors:</strong> When someone asks their town for a good roofer or painter, and you get recommended, you show up with trust already built.</span>
          </li>
          <li>
            <i data-lucide="check" style="color: #059669; width: 16px; height: 16px; flex-shrink: 0; margin-top: 3px;"></i>
            <span><strong>Your Area Is Protected:</strong> We only partner with one roofer, one remodeler, etc., per town. We never help your competitors.</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- How It Works & Territory Form -->
  <section class="benefits" id="benefits">
    <div class="section-header">
      <span class="section-tag"><i data-lucide="shield-check" style="width: 13px; height: 13px;"></i> How We Start</span>
      <h2>Three Steps To Fill Your Schedule</h2>
      <p>Here is how we get your phones ringing in the first two weeks.</p>
    </div>

    <div class="benefits-grid">
      <div class="benefits-list">
        <div class="benefit-item">
          <div class="benefit-icon">1</div>
          <div class="benefit-content">
            <h4>Pick Your Towns &amp; Trade</h4>
            <p>Tell us your service zip codes and what jobs you want more of (roofs, additions, bathrooms, siding, etc.).</p>
          </div>
        </div>

        <div class="benefit-item">
          <div class="benefit-icon">2</div>
          <div class="benefit-content">
            <h4>We Build Your Local Reputation</h4>
            <p>Our team shares your real project photos, reviews, and answers homeowner inquiries across your local community groups.</p>
          </div>
        </div>

        <div class="benefit-item">
          <div class="benefit-icon">3</div>
          <div class="benefit-content">
            <h4>You Book The Estimates</h4>
            <p>Homeowners call and text you directly. You show up, give the quote, and close the contract.</p>
          </div>
        </div>
      </div>

      <!-- Quick Territory Availability Box -->
      <div class="consultation-box" id="contact">
        <h3>Check If Your Town Is Still Open</h3>
        <p>Because we only represent one contractor per trade per area, check if your service zip codes are still open.</p>

        <form id="strategyLeadForm" class="consultation-form">
          <div class="form-group">
            <input type="text" name="name" placeholder="Your Full Name" required>
          </div>

          <div class="form-group">
            <input type="email" name="email" placeholder="Your Business Email" required>
          </div>

          <div class="form-group">
            <input type="tel" name="phone" placeholder="Phone Number (for instant text alerts)">
          </div>

          <div class="form-group">
            <select name="service_needed">
              <option value="Roofing & Exteriors">Roofing &amp; Exteriors</option>
              <option value="Home Remodeling">Home Remodeling &amp; Kitchens</option>
              <option value="Fencing & Decking">Fencing &amp; Decking</option>
              <option value="HVAC & Plumbing">HVAC &amp; Plumbing</option>
              <option value="Concrete & Coatings">Garage &amp; Floor Coatings</option>
              <option value="Other Home Services">Other Local Service Business</option>
            </select>
          </div>

          <div class="form-group">
            <textarea name="message" rows="2" placeholder="Enter your target city or service zip codes..."></textarea>
          </div>

          <button type="submit" class="btn-primary" style="width: 100%; justify-content: center; margin-top: 4px;">
            <span>Check My Territory Availability</span>
            <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
          </button>

          <div style="margin-top: 10px; text-align: center; font-size: 0.85rem; color: var(--text-muted);">
            Want to talk to someone right now? Call or text:
            <a href="tel:<%= (typeof settings !== 'undefined' && settings && settings.contact_phone) ? settings.contact_phone.replace(/[^0-9+]/g, '') : '+13477664135' %>" style="color: var(--forest-green); font-weight: 800; text-decoration: none;">
              <%= (typeof settings !== 'undefined' && settings && settings.contact_phone) ? settings.contact_phone : '+1 (347) 766-4135' %>
            </a>
          </div>
        </form>
      </div>
    </div>
  </section>

<%- include('partials/footer') %>
