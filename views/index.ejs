<%- include('partials/header') %>

<!-- 1. DYNAMIC TWO-COLUMN HERO SECTION -->
<section class="hero">
  <div class="container">
    <div class="hero-grid">
      
      <!-- Left Column: High-Impact Copy & Actions -->
      <div class="hero-text-col">
        <div class="badge-pill badge-gold">
          <i data-lucide="sparkles" style="width: 14px; height: 14px;"></i>
          <span><%= (settings && settings.hero_badge_text) || '200+ Businesses Scaled & $12M+ Organic Revenue' %></span>
        </div>

        <h1 class="hero-title">
          <%= (settings && settings.hero_title_prefix) || 'Turn Community Trust into Your' %> <br>
          <span class="title-highlight"><%= (settings && settings.hero_title_highlight) || 'Greatest Growth Engine' %></span>
        </h1>

        <p class="hero-subtitle">
          <%= (settings && settings.hero_subtitle) || "Unlock a predictable stream of qualified, high-ticket organic leads and build an undeniable local authority without spending a dime on ads. Inspired by nature's master engineer, we bridge your craftsmanship directly with motivated local homeowners." %>
        </p>

        <!-- Primary & Secondary CTAs -->
        <div class="hero-ctas">
          <a href="<%= (settings && settings.hero_cta_primary_link) || '/contact' %>" class="btn btn-moss">
            <span><%= (settings && settings.hero_cta_primary_text) || 'Get Your Free Strategy Session' %></span>
            <i data-lucide="arrow-right" style="width: 17px; height: 17px;"></i>
          </a>
          <a href="<%= (settings && settings.hero_cta_secondary_link) || '/projects' %>" class="btn btn-outline-forest">
            <i data-lucide="folder-check" style="width: 17px; height: 17px;"></i>
            <span><%= (settings && settings.hero_cta_secondary_text) || 'Explore Proven Work' %></span>
          </a>
        </div>

        <!-- Social Proof Trust Micro-Bar -->
        <div class="hero-trust-proof">
          <div class="trust-avatar-stack">
            <img src="/images/avatars/justin.jpg" alt="Justin Nadeau" class="stack-avatar">
            <img src="/images/avatars/john.jpg" alt="John Bradley" class="stack-avatar">
            <img src="/images/avatars/greg.jpg" alt="Greg Van Horn" class="stack-avatar">
            <img src="/images/avatars/sarah.jpg" alt="Sarah Lindqvist" class="stack-avatar">
          </div>
          <div>
            <div style="display: flex; gap: 3px; color: var(--acorn-gold); font-size: 0.95rem;">
              ★★★★★
            </div>
            <div style="font-size: 0.85rem; font-weight: 700; color: var(--text-primary); margin-top: 1px;">
              <%= (settings && settings.hero_rating_text) || 'Rated 4.9/5 by 200+ Home Service Contractors' %>
            </div>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive 3D Emblem Showcase with Floating Performance Cards -->
      <div class="hero-visual-col">
        <div class="hero-visual-wrapper">
          <!-- Ambient Nature Glow Rings -->
          <div class="hero-ambient-glow"></div>
          
          <!-- 3D Master Emblem -->
          <img src="<%= (settings && settings.hero_image_url) || '/images/logo.png' %>" alt="Beaver's Bridge Master Crest" class="hero-emblem-main" id="heroMainImage">

          <!-- Floating Badge 1: Top Right (+163 Leads) -->
          <div class="floating-badge badge-top-right">
            <div class="float-icon-box" style="background: rgba(1, 81, 18, 0.1); color: var(--forest-green);">
              <i data-lucide="trending-up" style="width: 16px; height: 16px;"></i>
            </div>
            <div>
              <div class="float-title"><%= (settings && settings.float_badge_1_title) || '+163 Qualified Leads' %></div>
              <div class="float-sub"><%= (settings && settings.float_badge_1_sub) || '$420,000+ In Pipeline' %></div>
            </div>
          </div>

          <!-- Floating Badge 2: Bottom Left (60% Close Rate) -->
          <div class="floating-badge badge-bottom-left">
            <div class="float-icon-box" style="background: rgba(156, 114, 33, 0.12); color: var(--acorn-gold);">
              <i data-lucide="target" style="width: 16px; height: 16px;"></i>
            </div>
            <div>
              <div class="float-title"><%= (settings && settings.float_badge_2_title) || '60% Booking Rate' %></div>
              <div class="float-sub"><%= (settings && settings.float_badge_2_sub) || '$240 Avg Customer Acq' %></div>
            </div>
          </div>

          <!-- Floating Badge 3: Bottom Right (Zero Ad Spend) -->
          <div class="floating-badge badge-bottom-right">
            <div class="float-icon-box" style="background: rgba(96, 141, 154, 0.15); color: var(--river-blue);">
              <i data-lucide="shield-check" style="width: 16px; height: 16px;"></i>
            </div>
            <div>
              <div class="float-title"><%= (settings && settings.float_badge_3_title) || '100% Organic Trust' %></div>
              <div class="float-sub"><%= (settings && settings.float_badge_3_sub) || '$0 In Ad Spend' %></div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- 2. TRUST & IMPACT STATS TICKER (Compact & Crisp) -->
<section class="trust-bar">
  <div class="container">
    <div class="trust-stats-grid">
      <div>
        <div class="trust-stat-num"><%= (settings && settings.stat_1_num) || '30,000+' %></div>
        <div class="trust-stat-label"><%= (settings && settings.stat_1_label) || 'Monthly Organic Impressions' %></div>
      </div>
      <div>
        <div class="trust-stat-num"><%= (settings && settings.stat_2_num) || '4.5+' %></div>
        <div class="trust-stat-label"><%= (settings && settings.stat_2_label) || 'Weekly Qualified Inbound Leads' %></div>
      </div>
      <div>
        <div class="trust-stat-num"><%= (settings && settings.stat_3_num) || '$240' %></div>
        <div class="trust-stat-label"><%= (settings && settings.stat_3_label) || 'Average Customer Acquisition Cost' %></div>
      </div>
      <div>
        <div class="trust-stat-num"><%= (settings && settings.stat_4_num) || '$12.4M+' %></div>
        <div class="trust-stat-label"><%= (settings && settings.stat_4_label) || 'Verified Client Revenue Generated' %></div>
      </div>
    </div>
  </div>
</section>

<!-- 3. COMPARISON: BEYOND TRADITIONAL MARKETING -->
<section class="section section-white" id="comparison">
  <div class="container">
    <div class="section-header">
      <div class="badge-pill badge-gold">
        <i data-lucide="shield" style="width: 14px; height: 14px;"></i>
        <span>Beyond Traditional Marketing</span>
      </div>
      <h2 class="section-title">
        Why Paid Ads Flop &amp; <span class="text-gold">Why Community Trust Wins</span>
      </h2>
      <p class="section-desc">
        Traditional ads come and go, but an authentic community presence lasts forever. See why the highest-earning contractors and regional businesses are abandoning the paid-ad treadmill.
      </p>
    </div>

    <div class="comparison-grid">
      <!-- Traditional Ads -->
      <div class="comparison-card card-traditional">
        <span class="comparison-badge badge-neg">The Traditional Ad Treadmill</span>
        <h3>Expensive PPC &amp; Cold Canvassing</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem;">
          You spend thousands every month on Facebook &amp; Google PPC ads. The moment you pause ad spend, your lead pipeline immediately dries up.
        </p>

        <ul class="comparison-list">
          <li class="comparison-item" style="color: #991b1b;">
            <i data-lucide="x-circle" style="color: #ef4444; width: 18px; height: 18px;"></i>
            <span>Skyrocketing cost-per-click and low-intent price shoppers.</span>
          </li>
          <li class="comparison-item" style="color: #991b1b;">
            <i data-lucide="x-circle" style="color: #ef4444; width: 18px; height: 18px;"></i>
            <span>Severe ad fatigue: neighbors scroll past and ignore banners.</span>
          </li>
          <li class="comparison-item" style="color: #991b1b;">
            <i data-lucide="x-circle" style="color: #ef4444; width: 18px; height: 18px;"></i>
            <span>Zero compounding equity; you rent your audience each month.</span>
          </li>
          <li class="comparison-item" style="color: #991b1b;">
            <i data-lucide="x-circle" style="color: #ef4444; width: 18px; height: 18px;"></i>
            <span>Suspicious prospects requiring stressful, high-pressure sales calls.</span>
          </li>
        </ul>
      </div>

      <!-- Beaver's Bridge Organic -->
      <div class="comparison-card card-beavers">
        <span class="comparison-badge badge-pos">The Beaver's Bridge Method</span>
        <h3>Organic Community Domination</h3>
        <p style="color: var(--text-body); font-size: 0.95rem;">
          We embed your business into high-density local community hubs as the verified, trusted authority that neighbors recommend by name.
        </p>

        <ul class="comparison-list">
          <li class="comparison-item" style="color: var(--forest-green); font-weight: 600;">
            <i data-lucide="check-circle" style="color: var(--forest-green); width: 18px; height: 18px;"></i>
            <span>$0 in ad spend with dramatically lower customer acquisition costs ($240 avg).</span>
          </li>
          <li class="comparison-item" style="color: var(--forest-green); font-weight: 600;">
            <i data-lucide="check-circle" style="color: var(--forest-green); width: 18px; height: 18px;"></i>
            <span>Pre-sold prospects: leads arrive already trusting your craftsmanship.</span>
          </li>
          <li class="comparison-item" style="color: var(--forest-green); font-weight: 600;">
            <i data-lucide="check-circle" style="color: var(--forest-green); width: 18px; height: 18px;"></i>
            <span>Evergreen compound growth: reputation snowballs over months and years.</span>
          </li>
          <li class="comparison-item" style="color: var(--forest-green); font-weight: 600;">
            <i data-lucide="check-circle" style="color: var(--forest-green); width: 18px; height: 18px;"></i>
            <span>Natural "word-of-mouth" multiplication across digital town squares.</span>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- 4. CORE SERVICES SECTION (Compact Cards) -->
<section class="section section-cream" id="services">
  <div class="container">
    <div class="section-header">
      <div class="badge-pill">
        <i data-lucide="layers" style="width: 14px; height: 14px;"></i>
        <span>Our Full-Funnel Growth Architecture</span>
      </div>
      <h2 class="section-title">
        Services That Build <span class="text-gold">Enduring Authority &amp; Leads</span>
      </h2>
      <p class="section-desc">
        We handle the entire community engine for you: from identifying high-intent groups and writing native craftsmanship copy, to real-time conversation nurturing and inbound booking.
      </p>
    </div>

    <div class="services-grid">
      <% services.forEach(service => { %>
        <div class="service-card">
          <div class="service-icon-box">
            <i data-lucide="<%= service.icon || 'star' %>" style="width: 26px; height: 26px;"></i>
          </div>
          <h3><%= service.title %></h3>
          <p><%= service.description %></p>

          <ul class="service-deliverables">
            <% (service.deliverables || []).slice(0, 3).forEach(item => { %>
              <li class="service-deliverable-item">
                <i data-lucide="check" style="width: 14px; height: 14px;"></i>
                <span><%= item %></span>
              </li>
            <% }) %>
          </ul>

          <a href="/contact" class="btn btn-outline-forest" style="margin-top: auto; font-size: 0.85rem; padding: 9px 16px;">
            <span>Learn More &amp; Deploy</span>
            <i data-lucide="chevron-right" style="width: 14px; height: 14px;"></i>
          </a>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- 5. FEATURED PROJECTS / CASE STUDIES -->
<section class="section section-white" id="projects">
  <div class="container">
    <div class="projects-header-row">
      <div>
        <div class="badge-pill badge-gold">
          <i data-lucide="trophy" style="width: 14px; height: 14px;"></i>
          <span>Proven Track Record</span>
        </div>
        <h2 class="section-title" style="margin-bottom: 0;">
          Previous Work &amp; <span class="text-gold">Verified Case Studies</span>
        </h2>
      </div>
      <div>
        <a href="/projects" class="btn btn-outline-forest">
          <span>View All Case Studies</span>
          <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
        </a>
      </div>
    </div>

    <div class="projects-grid">
      <% projects.forEach(p => { %>
        <div class="project-card"
          data-id="<%= p.id %>"
          data-title="<%= p.title %>"
          data-client="<%= p.client %>"
          data-category="<%= p.category %>"
          data-summary="<%= p.summary %>"
          data-challenge="<%= p.challenge %>"
          data-solution="<%= p.solution %>"
          data-metrics="<%= p.metrics %>"
          data-image="<%= p.image_url %>"
          data-live="<%= p.live_url %>">
          
          <div class="project-img-box">
            <img src="<%= p.image_url %>" alt="<%= p.title %>" class="project-img">
            <span class="project-category-tag"><%= p.category %></span>
          </div>

          <div class="project-content">
            <h3 class="project-title"><%= p.title %></h3>
            <div class="project-client"><%= p.client %></div>
            <p class="project-summary"><%= p.summary %></p>

            <div class="project-metrics-box">
              <i data-lucide="trending-up" style="color: var(--forest-green); width: 17px; height: 17px; flex-shrink: 0;"></i>
              <span class="project-metrics-text"><%= p.metrics %></span>
            </div>

            <div class="project-footer">
              <button class="btn-case-study">
                <span>View Full Case Study</span>
                <i data-lucide="arrow-up-right" style="width: 14px; height: 14px;"></i>
              </button>
              <% if (p.live_url) { %>
                <a href="<%= p.live_url %>" target="_blank" rel="noopener noreferrer" style="color: var(--text-muted);" aria-label="Visit client website">
                  <i data-lucide="external-link" style="width: 14px; height: 14px;"></i>
                </a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- 6. TESTIMONIALS / SUCCESS STORIES -->
<section class="section section-cream" id="testimonials">
  <div class="container">
    <div class="section-header">
      <div class="badge-pill">
        <i data-lucide="star" style="width: 14px; height: 14px;"></i>
        <span>Real Client Outcomes</span>
      </div>
      <h2 class="section-title">
        Hear What Our <span class="text-gold">Partners Have To Say</span>
      </h2>
      <p class="section-desc">
        Our clients don't just generate leads; they become household names and trusted authorities in their local territories.
      </p>
    </div>

    <div class="testimonials-grid">
      <% testimonials.forEach(t => { %>
        <div class="testimonial-card">
          <div style="display: flex; gap: 4px; color: var(--acorn-gold); margin-bottom: 12px;">
            <% for (let i = 0; i < t.rating; i++) { %>
              <i data-lucide="star" style="width: 15px; height: 15px; fill: currentColor;"></i>
            <% } %>
          </div>

          <div class="testimonial-metric-callout">
            <i data-lucide="zap" style="width: 13px; height: 13px;"></i>
            <span><%= t.highlight_metric %></span>
          </div>

          <p class="testimonial-quote">
            "<%= t.quote %>"
          </p>

          <div class="testimonial-author-row">
            <img src="<%= t.avatar_url || '/images/avatars/justin.jpg' %>" alt="<%= t.client_name %>" class="author-avatar">
            <div class="author-info">
              <h4><%= t.client_name %></h4>
              <p><%= t.client_role %>, <%= t.client_company %></p>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- 7. THE 4-STEP BEAVER & SQUIRREL COLLABORATION PROCESS -->
<section class="section section-white" id="process">
  <div class="container">
    <div class="section-header">
      <div class="badge-pill badge-gold">
        <i data-lucide="git-branch" style="width: 14px; height: 14px;"></i>
        <span>Collaboration &amp; Growth Storytelling</span>
      </div>
      <h2 class="section-title">
        The 4-Step Beaver's Bridge <span class="text-forest">Organic System</span>
      </h2>
      <p class="section-desc">
        Like the industrious beaver and agile squirrel working in perfect harmony, we combine strategic group intelligence with master craftsmanship to bridge community trust.
      </p>
    </div>

    <div class="process-grid">
      <div class="process-card">
        <div class="process-step-num">01</div>
        <h3>Strategic Group Whitelisting</h3>
        <p>We audit and penetrate the top 15–30 high-income Facebook groups in your immediate service radius where homeowners actively seek recommendations.</p>
      </div>

      <div class="process-card">
        <div class="process-step-num">02</div>
        <h3>Craftsmanship Storytelling</h3>
        <p>Our copywriters craft compelling before-and-after narratives and problem-solving showcases that highlight your work without feeling like a commercial ad.</p>
      </div>

      <div class="process-card">
        <div class="process-step-num">03</div>
        <h3>Peer-to-Peer Dialogue</h3>
        <p>We nurture comment threads, provide free expert advice, and build genuine community rapport that positions you as the undisputed local authority.</p>
      </div>

      <div class="process-card">
        <div class="process-step-num">04</div>
        <h3>Inbound Lead Harvesting</h3>
        <p>Homeowners transition seamlessly into direct messages and discovery calls with pre-established trust and an average 60%+ appointment booking rate.</p>
      </div>
    </div>
  </div>
</section>

<!-- 8. FAQ ACCORDION SECTION -->
<section class="section section-cream" id="faq">
  <div class="container">
    <div class="section-header">
      <div class="badge-pill">
        <i data-lucide="help-circle" style="width: 14px; height: 14px;"></i>
        <span>Common Inquiries</span>
      </div>
      <h2 class="section-title">
        Frequently Asked Questions
      </h2>
      <p class="section-desc">
        Everything you need to know about our organic community lead generation system.
      </p>
    </div>

    <div class="faq-container">
      <div class="faq-item active">
        <button class="faq-trigger">
          <span>How many community groups do you manage and post in daily?</span>
          <i data-lucide="chevron-down" class="faq-icon"></i>
        </button>
        <div class="faq-body">
          We identify, vet, and actively manage between 15 to 30 hyper-local community groups per geographic service territory. Our posting cadence is carefully staggered to ensure natural, organic dialogue without triggering spam flags or moderator scrutiny.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger">
          <span>How do you avoid sounding spammy or getting banned from groups?</span>
          <i data-lucide="chevron-down" class="faq-icon"></i>
        </button>
        <div class="faq-body">
          We do not post spammy sales links, discount codes, or generic ads. Instead, our expert copywriters craft educational, value-first narratives highlighting real craftsmanship challenges, before-and-after transformations, and genuine homeowner tips. Group admins and members appreciate and welcome our content because it elevates community standards.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger">
          <span>What average monthly impressions and leads can a business expect?</span>
          <i data-lucide="chevron-down" class="faq-icon"></i>
        </button>
        <div class="faq-body">
          On average, our clients generate 30,000+ targeted organic monthly impressions and between 4 to 8 qualified, high-ticket inbound leads weekly. Unlike paid clicks where prospects bounce immediately, community leads arrive with pre-existing trust, yielding booking rates upwards of 60%.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger">
          <span>What industries benefit the most from Beaver's Bridge?</span>
          <i data-lucide="chevron-down" class="faq-icon"></i>
        </button>
        <div class="faq-body">
          Our system is uniquely effective for home service contractors, kitchen &amp; bath remodelers, garage floor coating specialists, roofers, custom closet designers, HVAC &amp; solar providers, and high-ticket local services where trust and craftsmanship are the primary deciding factors.
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-trigger">
          <span>How quickly do we see our first inbound leads?</span>
          <i data-lucide="chevron-down" class="faq-icon"></i>
        </button>
        <div class="faq-body">
          Typically, within the first 14 days of launching your custom community strategy, your brand will begin receiving direct homeowner inquiries, comment mentions, and consultation requests as your authority posts gain traction in targeted groups.
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 9. STRATEGY CALL / CONSULTATION FORM SECTION (Crisp & Compact) -->
<section class="booking-section" id="contact">
  <div class="container">
    <div class="booking-card">
      <div class="booking-info">
        <div class="badge-pill badge-gold">
          <i data-lucide="calendar" style="width: 14px; height: 14px;"></i>
          <span>Zero Obligation Consultation</span>
        </div>
        <h2>
          Ready to Turn Community Trust into <span class="text-gold">Predictable Growth?</span>
        </h2>
        <p>
          Book your free 30-minute growth strategy session today. We’ll audit your local territory, identify untapped neighborhood groups, and lay out an actionable roadmap to scale your organic lead pipeline.
        </p>

        <ul class="booking-perks">
          <li class="booking-perk-item">
            <i data-lucide="check" style="width: 18px; height: 18px;"></i>
            <span>Access thousands of motivated homeowners in your local radius.</span>
          </li>
          <li class="booking-perk-item">
            <i data-lucide="check" style="width: 18px; height: 18px;"></i>
            <span>Build genuine word-of-mouth recognition that outlasts ads.</span>
          </li>
          <li class="booking-perk-item">
            <i data-lucide="check" style="width: 18px; height: 18px;"></i>
            <span>Cut your customer acquisition cost to a fraction of PPC ads.</span>
          </li>
          <li class="booking-perk-item">
            <i data-lucide="check" style="width: 18px; height: 18px;"></i>
            <span>No long-term contracts; proven month-over-month ROI.</span>
          </li>
        </ul>
      </div>

      <!-- Lead Capture Form -->
      <form class="booking-form" id="strategyLeadForm">
        <div class="form-row">
          <div class="form-group">
            <label for="leadName">Your Full Name *</label>
            <input type="text" id="leadName" name="name" class="form-input" placeholder="e.g. Marcus Vance" required>
          </div>
          <div class="form-group">
            <label for="leadEmail">Business Email *</label>
            <input type="email" id="leadEmail" name="email" class="form-input" placeholder="marcus@yourcompany.com" required>
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="leadPhone">Phone Number</label>
            <input type="tel" id="leadPhone" name="phone" class="form-input" placeholder="(555) 000-0000">
          </div>
          <div class="form-group">
            <label for="leadCompany">Company / Brand Name</label>
            <input type="text" id="leadCompany" name="company" class="form-input" placeholder="e.g. Vance Remodeling">
          </div>
        </div>

        <div class="form-row">
          <div class="form-group">
            <label for="leadService">Primary Service Needed</label>
            <select id="leadService" name="service_needed" class="form-select">
              <option value="Full Community Lead Gen System">Full Community Lead Gen System</option>
              <option value="Authority Content &amp; Copywriting">Authority Content &amp; Copywriting</option>
              <option value="Strategic Group Selection &amp; Setup">Strategic Group Selection &amp; Setup</option>
              <option value="Multi-Channel Repurposing">Multi-Channel Repurposing</option>
              <option value="General Consultation">General Consultation</option>
            </select>
          </div>
          <div class="form-group">
            <label for="leadBudget">Target Monthly Revenue / Budget</label>
            <select id="leadBudget" name="monthly_budget" class="form-select">
              <option value="$10k - $25k / mo">$10k - $25k / mo</option>
              <option value="$25k - $50k / mo">$25k - $50k / mo</option>
