# ==============================================================================
# Beaver's Bridge - Environment Configuration Template
# Copy this file to .env and configure your environment-specific values
# ==============================================================================

# Server Port (default: 3000)
PORT=3000

# Express Session Cookie Secret Key (generate a secure random 32+ char string in production)
SESSION_SECRET=change-this-to-a-secure-random-secret-key-min-32-chars

# Initial Administrator Credentials (used only when initially provisioning the database)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-admin-password
